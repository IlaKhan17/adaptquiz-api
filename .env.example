# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-32-random-bytes

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (SQLite, no extra setup):
DATABASE_URL=sqlite+aiosqlite:///./adaptquiz.db

# Production (PostgreSQL — AWS RDS or Neon):
# DATABASE_URL=postgresql+asyncpg://user:password@your-rds-host.rds.amazonaws.com/adaptquiz?ssl=require

# ── FAISS index ───────────────────────────────────────────────────────────────
# Local / single-container: default path (persisted via EFS on AWS ECS)
FAISS_INDEX_PATH=./data/faiss

# ── CORS ──────────────────────────────────────────────────────────────────────
# https://adaptquiz.ilarehman.com and https://ilarehman.com are always allowed.
# Add extra comma-separated origins here if needed (not required for local dev —
# the Vite dev server proxies /api to the backend):
# CORS_ORIGINS=http://localhost:5173

# ── Uploads ───────────────────────────────────────────────────────────────────
# MAX_UPLOAD_MB=20

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── AWS deployment notes ──────────────────────────────────────────────────────
# 1. Use AWS Secrets Manager or Parameter Store to inject secrets at runtime.
# 2. Mount an EFS volume at /app/data so FAISS index persists across container restarts.
# 3. Set DATABASE_URL to an RDS PostgreSQL instance.
# 4. Add any extra frontend domains to CORS_ORIGINS (never use "*" in production).
# 5. Build the Docker image: docker build -t adaptquiz-api .
#    Push to ECR:            docker tag adaptquiz-api <account>.dkr.ecr.<region>.amazonaws.com/adaptquiz-api
#                            docker push <account>.dkr.ecr.<region>.amazonaws.com/adaptquiz-api
