# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-32-random-bytes

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (SQLite, no extra setup):
DATABASE_URL=sqlite+aiosqlite:///./adaptquiz.db

# Production (Neon PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Optional ──────────────────────────────────────────────────────────────────
FAISS_INDEX_PATH=./data/faiss

# ── CORS ──────────────────────────────────────────────────────────────────────
# Development (open — no credentials allowed when using "*"):
# CORS_ORIGINS=*
# Production (comma-separated list of allowed frontend origins):
# CORS_ORIGINS=https://your-frontend.railway.app,https://www.yourdomain.com
